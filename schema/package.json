{
  "name": "@dsh-market/schema",
  "version": "0.1.4",
  "type": "module",
  "main": "dist/types.js",
  "types": "dist/types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./zh-intent": {
      "types": "./dist/zh-intent.d.ts",
      "default": "./dist/zh-intent.js"
    },
    "./zh-taxonomy": {
      "types": "./dist/zh-taxonomy.d.ts",
      "default": "./dist/zh-taxonomy.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "description": "DSH Market shared types + zh-intent dictionary / zh-taxonomy matcher (DshPlugin / MarketData / PracticalScore)",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "types"
  ]
}
