{
  "name": "@dsh-market/plugin",
  "version": "0.4.7",
  "description": "DSH Market 插件端：cordis 侧边栏插件（浏览/搜索/猜你喜欢/一键安装/已装管理），核心逻辑来自 @dsh-market/core",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./invariant": {
      "default": "./lib/invariant.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node test/client-dual-path.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@dsh-market/core": "^0.4.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "market",
    "cordis"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.25.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
